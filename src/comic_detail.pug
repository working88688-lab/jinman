        ul(class='detail-page__hot-list')
          each _ in [1, 2, 3, 4, 5, 6]
            li
              a(class='detail-page__hot-card' href='comic_detail.html?id=1')
                div(class='detail-page__hot-aspect')
                  div(class='detail-page__hot-poster')
                    img(class='detail-page__hot-img' src='/static/frontend/images/loading.svg' alt='')
                    div(class='detail-page__hot-badges detail-page__hot-badges--top')
                      span(class='detail-page__hot-badge detail-page__hot-badge--primary') 原创
                      span(class='detail-page__hot-badge detail-page__hot-badge--muted') 连载中
                div(class='detail-page__hot-body')
                  div(class='detail-page__hot-name') 七个媳妇娇又软

      +DetailInfoShare()

block dialog
  include includes/dialog/dx-reply-dialog.pug
  include includes/dialog/dx-comment-dialog.pug
  include includes/dialog/dx-report-dialog.pug


block footer-scripts
  script(data-main='/static/frontend/js/novel_detail_main.js' src="/static/frontend/js/lib/require.js")

