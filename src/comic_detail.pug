extends includes/layout.pug

include includes/mixin/dx-detail-info-share.pug

block css
  link(rel='stylesheet' href='/static/frontend/css/new_searchbox.css')
  link(rel='stylesheet' href='/static/frontend/css/detail_pages.css')


block header
  +Header({
    active: 'comic',
    showHeader: true,
    placeholder: '搜索禁漫作品',
    search_type: 'comic'
  })
block nav
  +Nav

block content

  div(class='detail-page text-font1')
    div(class='detail-page__inner')
      +Breadcrumbs([{ title: '禁漫漫画', isLink: true, href: 'comic.html'}, { isLink: false },{ title: '全部漫画', isLink: true, href: 'comic_list.html'}, { isLink: false}, { title: '完蛋了，被七大魔女强上了！', isLink: true} ])

      div(class='detail-page__card')
        div(class='detail-page__hero')
          div(class='detail-page__cover-col')
            div(class='detail-page__cover-wrap')
              div(class='detail-page__poster-frame')
                img(class='detail-page__poster-img' src='/static/frontend/images/loading.svg' alt='poster')

              div(class='detail-page__rating-pc')
                div(class='detail-page__rating-box')
                  div(class='detail-page__stars-row')
                    svg(class='detail-page__star-icon')
                      use(href='/static/frontend/icons/icons.svg#star_red')
                    svg(class='detail-page__star-icon')
                      use(href='/static/frontend/icons/icons.svg#star_red')
                    svg(class='detail-page__star-icon')
                      use(href='/static/frontend/icons/icons.svg#star_red')
                    svg(class='detail-page__star-icon')
                      use(href='/static/frontend/icons/icons.svg#star_red')
                    svg(class='detail-page__star-icon')
                      use(href='/static/frontend/icons/icons.svg#star_icon')
                  div(class='detail-page__rating-meta') 共 999,999 人参与评分

          div(class='detail-page__body')
            div(class='dx-title detail-page__title') 作品名称作品名称作品名称作品名称作品

            div(class='detail-page__rating-m')
              div(class='detail-page__stars-row--m')
                svg(class='detail-page__star-icon')
                  use(href='/static/frontend/icons/icons.svg#star_red')
                svg(class='detail-page__star-icon')
                  use(href='/static/frontend/icons/icons.svg#star_red')
                svg(class='detail-page__star-icon')
                  use(href='/static/frontend/icons/icons.svg#star_red')
                svg(class='detail-page__star-icon')
                  use(href='/static/frontend/icons/icons.svg#star_red')
                svg(class='detail-page__star-icon')
                  use(href='/static/frontend/icons/icons.svg#star_icon')
              div(class='detail-page__rating-m-text') 共 999,999 人参与评分

            div(class='detail-page__meta-row')
              div 日本H漫
              div(class='detail-page__meta-item')
                svg(width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg")
