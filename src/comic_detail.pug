.62428 6.78112 7.95155 6.5752 8.28418H7.39746C7.41828 8.28418 7.51985 8.26857 7.72266 8.03125C7.91475 7.80645 8.11526 7.48198 8.35156 7.0791C8.57052 6.70578 8.81853 6.26496 9.10742 5.83984Z" stroke="#666666")
                span 作者名称
              div(class='flex items-center gap-[6px]')
                svg(width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg")
                  path(d="M3.51855 4.07227C3.779 3.02804 4.89544 2.37333 5.96484 2.75293L6.40039 2.90723L6.85449 3.07422C9.11507 3.92809 11.2368 5.11388 13.1494 6.59375C13.3641 6.75991 13.5386 6.97307 13.6582 7.2168C13.7777 7.46049 13.8398 7.72858 13.8398 8C13.8398 8.27144 13.7778 8.5395 13.6582 8.7832C13.5386 9.02693 13.3641 9.24009 13.1494 9.40625C11.2368 10.8861 9.11506 12.0719 6.85449 12.9258L6.40039 13.0928L5.96484 13.2471C4.89552 13.6266 3.77908 12.9718 3.51855 11.9277L3.47852 11.7139C3.15822 9.24839 3.15822 6.75161 3.47852 4.28613L3.51855 4.07227Z" stroke="#666666")
                span 连载中
              div(class='flex items-center gap-[6px]')
                svg(width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg")
                  path(d="M8.00098 1.8335C9.63636 1.83358 11.2049 2.48374 12.3613 3.64014C13.5176 4.79658 14.167 6.36514 14.167 8.00049C14.1669 9.63587 13.5177 11.2044 12.3613 12.3608C11.2049 13.5172 9.63636 14.1664 8.00098 14.1665C6.36563 14.1665 4.79707 13.5171 3.64062 12.3608C2.48423 11.2044 1.83407 9.63587 1.83398 8.00049C1.83398 6.36499 2.48415 4.79661 3.64062 3.64014C4.7971 2.48366 6.36547 1.8335 8.00098 1.8335ZM8.00098 8.00049H8L10 9.25049H10.001L8.23535 8.14697L8.00098 7.99951V8.00049Z" stroke="#666666")
                span 2025-12-16 更新

            div(class='mt-4 md:mt-4 min-h-[192px] md:h-[192px] bg-[#F5F5F5] rounded-[5px] px-[12px] md:px-[20px] py-[12px] md:py-[13px] flex overflow-hidden')
              div(class='w-6 md:w-6 flex-shrink-0 flex items-center justify-center')
                div(class='font-semibold text-black tracking-[0.35em] [writing-mode:vertical-rl] [text-orientation:upright] leading-none') 作品简介
              div(class='w-[1px] bg-[rgba(211,211,211,1)] mx-[12px] md:mx-[12px] rounded-full')
              div(class='flex-1 text-[12px] leading-[1.8] text-font1 text-[#333333]') 这里是作品简介，字数超过适用「……」显示。这里是作品简介，字数超过适用「……」显示。这里是作品简介，字数超过适用「……」显示。这里是作品简介，字数超过适用「……」显示。

            div(class='mt-4 md:mt-3 flex flex-col md:flex-row items-stretch md:items-center gap-[10px] md:gap-[12px]')
              //- 唯一差异：开始阅读路径
              a(class='btn btn-primary text-[16px]! w-full md:w-[353px] h-[52px] md:h-[70px] leading-[52px] md:leading-[70px] flex items-center justify-center !px-0 !py-0 !text-white rounded-[5px] flex-shrink-0' href='comic_chapter.html?id=1') 开始阅读

              div(class='w-full flex-1 border border-border rounded-[5px] px-5 py-4 md:p-0  md:h-[70px] flex items-stretch divide-x divide-border')
                div(class='flex-1 flex-center')
                  +BtnComment
                div(class='flex-1 flex-center')
                  +BtnLike({ type: 3})
                div(class='flex-1 flex-center')
                  +BtnShare
                div(class='flex-1 flex-center')
                  +BtnReport(2)

      //- 标签
      div(class='mt-4 flex flex-wrap gap-[12px]')
        a(class='w-[101px] h-[30px] rounded-[4px] bg-[#FFBEBE80] text-[#FF5656] text-[14px] leading-[14px] flex items-center justify-center whitespace-nowrap' href="video_list.html?tag=1") #标签
        a(class='w-[101px] h-[30px] rounded-[4px] bg-[#FFBEBE80] text-[#FF5656] text-[14px] leading-[14px] flex items-center justify-center whitespace-nowrap' href="video_list.html?tag=2") #标签

      //- 目录 / 评论（无外边框）
      div(class='mt-[30px] md:mt-6')
        div(class='px-[16px] md:px-[20px] h-[56px] flex items-center justify-between bg-white border-b border-[rgba(245,245,245,1)]')
          div(class='flex items-center gap-[24px]')
            button(type='button' class='novel-tab-btn relative flex items-center gap-[6px] text-[14px] md:text-[16px] font-semibold text-[rgba(236,99,93,1)]' data-tab='catalog')
              span 目录
              span(class='tab-catalog-count tab-count text-[rgba(236,99,93,1)]') (54)
              span(class='tab-underline absolute left-0 right-0 -bottom-[10px] h-[3px] bg-[#EC635D] rounded-full')
            button(type='button' class='novel-tab-btn relative flex items-center gap-[6px] text-[14px] md:text-[16px] font-semibold text-[rgba(102,102,102,1)]' data-tab='comments')
              span 评论
              span(class='tab-comment-count tab-count text-[rgba(102,102,102,1)]') (54)
              span(class='tab-underline hidden absolute left-0 right-0 -bottom-[10px] h-[3px] bg-[#EC635D] rounded-full')
          button(type='button' class='w-8 h-8 flex items-center justify-center text-[rgba(68,68,68,1)]')
            svg(class='w-5 h-5')
              use(href='/static/frontend/icons/icons.svg#sort')

        div
          div(class='novel-panel novel-panel-catalog w-full bg-white')
            div(class='')
              div(class='space-y-[10px]')
                a(class='h-[44px] md:h-[48px] rounded-[4px] border border-[rgba(245,245,245,1)] px-[14px] md:px-[16px] flex items-center text-[14px] md:text-[16px] text-[rgba(68,68,68,1)]' href='comic_chapter.html?id=1') 第1话 — 标题
                a(class='h-[44px] md:h-[48px] rounded-[4px] border border-[rgba(236,99,93,0.18)] px-[14px] md:px-[16px] flex items-center text-[14px] md:text-[16px] text-[rgba(68,68,68,1)] bg-[rgba(236,99,93,0.12)]' href='comic_chapter.html?id=2') 第2话 — 标题
                a(class='h-[44px] md:h-[48px] rounded-[4px] border border-[rgba(245,245,245,1)] px-[14px] md:px-[16px] flex items-center text-[14px] md:text-[16px] text-[rgba(68,68,68,1)]' href='comic_chapter.html?id=3') 第3话 — 标题
              div(class='mt-[22px] flex justify-center')
                button(type='button' class='btn-expand-catalog w-[220px] h-[44px] rounded-[6px] border border-[rgba(236,99,93,0.5)] text-[rgba(236,99,93,1)] flex items-center justify-center gap-[6px] text-[14px]')
                  span 全部展开
                  svg(class='w-4 h-4')
                    use(href='/static/frontend/icons/icons.svg#arrow_down')

          div(class='novel-panel novel-panel-comments hidden w-full bg-white')
            div(class='')
              include includes/components/dx-video-comment.pug
              div(class='mt-[22px] flex justify-center')
                button(type='button' class='w-[220px] h-[44px] rounded-[6px] border border-[rgba(236,99,93,0.5)] text-[rgba(236,99,93,1)] flex items-center justify-center gap-[6px] text-[14px]')
                  span 全部展开
                  svg(class='w-4 h-4')
                    use(href='/static/frontend/icons/icons.svg#arrow_down')
  

block dialog
  include includes/dialog/dx-reply-dialog.pug
  include includes/dialog/dx-comment-dialog.pug
  include includes/dialog/dx-report-dialog.pug


block footer-scripts
  //- 复用与 novel_detail 相同的 Tab 逻辑
  script(data-main='/static/frontend/js/novel_detail_main.js' src="/static/frontend/js/lib/require.js")

