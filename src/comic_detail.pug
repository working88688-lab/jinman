extends includes/layout.pug

block css
  link(rel='stylesheet' href='/static/frontend/css/new_searchbox.css')


block header
  +Header({
    active: 'comic',
    showHeader: true,
    placeholder: '搜索禁漫作品',
    search_type: 'comic'
  })
block nav
  +Nav

block content

  div(class='flex text-font1')
    div(class='flex-1 max-w-full')
      +Breadcrumbs([{ title: '禁漫漫画', isLink: true, href: 'comic.html'}, { isLink: false },{ title: '全部漫画', isLink: true, href: 'comic_list.html'}, { isLink: false}, { title: '完蛋了，被七大魔女强上了！', isLink: true} ])

      //- 外层边框：移动端单列，桌面端双列（与 novel_detail 一致）
      div(class='mt-3 border border-border rounded-[5px] px-[12px] py-[12px] md:px-[20px] md:py-[13px]')
        div(class='flex flex-col md:flex-row gap-[14px] md:gap-[24px]')
          //- 左侧封面：移动端居中，桌面端固定尺寸
          div(class='w-full md:w-[204px] md:flex-shrink-0 flex justify-center md:block')
            div(class='w-[204px]')
              div(class='w-[204px] h-[256px] rounded-sm overflow-hidden')
                img(class='w-full h-full object-cover' src='/static/frontend/images/loading.svg' alt='poster')

              //- PC：评分在图片下方（仅 md+ 显示）
              div(class='hidden md:block mt-3')
                div(class='w-[204px] h-[70px] box-border border border-[rgba(245,245,245,1)] rounded-[5px] px-[12px] py-[10px] flex flex-col justify-between overflow-hidden')
                  div(class='flex items-center justify-center gap-2')
                    svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                      use(href='/static/frontend/icons/icons.svg#star_red')
                    svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                      use(href='/static/frontend/icons/icons.svg#star_red')
                    svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                      use(href='/static/frontend/icons/icons.svg#star_red')
                    svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                      use(href='/static/frontend/icons/icons.svg#star_red')
                    svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                      use(href='/static/frontend/icons/icons.svg#star_icon')
                  div(class='text-[10px] leading-none text-[rgba(147,147,147,1)] text-right truncate') 共 999,999 人参与评分

          //- 右侧内容
          div(class='flex-1 min-w-0')
            div(class='dx-title w-full max-w-full font-semibold text-[32px] md:text-[15px] leading-[1.35] md:leading-none truncate') 作品名称作品名称作品名称作品名称作品

            //- H5：评分在标题下方（仅 <md 显示）
            div(class='md:hidden mt-4 w-full max-w-full box-border border border-[rgba(245,245,245,1)] rounded-[5px] px-[20px] py-[16px] flex items-center justify-between gap-3 overflow-hidden')
              div(class='flex items-center gap-2 flex-shrink-0')
                svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                  use(href='/static/frontend/icons/icons.svg#star_red')
                svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                  use(href='/static/frontend/icons/icons.svg#star_red')
                svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                  use(href='/static/frontend/icons/icons.svg#star_red')
                svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                  use(href='/static/frontend/icons/icons.svg#star_red')
                svg(class='w-6 h-6 text-[rgba(236,99,93,1)] fill-current')
                  use(href='/static/frontend/icons/icons.svg#star_icon')
              div(class='flex-1 min-w-0 truncate text-right text-[rgba(147,147,147,1)]') 共 999,999 人参与评分

            div(class='mt-4 md:mt-3 flex items-center flex-wrap gap-x-[16px] md:gap-x-[20px] gap-y-2 text-[#666666]')
              div 日本H漫
              div(class='flex items-center gap-[6px]')
                svg(width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg")
