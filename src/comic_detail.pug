                svg(width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg")
                  path(d="M8.00098 1.8335C9.63636 1.83358 11.2049 2.48374 12.3613 3.64014C13.5176 4.79658 14.167 6.36514 14.167 8.00049C14.1669 9.63587 13.5177 11.2044 12.3613 12.3608C11.2049 13.5172 9.63636 14.1664 8.00098 14.1665C6.36563 14.1665 4.79707 13.5171 3.64062 12.3608C2.48423 11.2044 1.83407 9.63587 1.83398 8.00049C1.83398 6.36499 2.48415 4.79661 3.64062 3.64014C4.7971 2.48366 6.36547 1.8335 8.00098 1.8335ZM8.00098 8.00049H8L10 9.25049H10.001L8.23535 8.14697L8.00098 7.99951V8.00049Z" stroke="#666666")
                span 2025-12-16 更新

            div(class='detail-page__synopsis')
              div(class='detail-page__synopsis-label-wrap')
                div(class='detail-page__synopsis-label') 作品简介
              div(class='detail-page__synopsis-rule')
              div(class='detail-page__synopsis-text') 这里是作品简介，字数超过适用「……」显示。这里是作品简介，字数超过适用「……」显示。这里是作品简介，字数超过适用「……」显示。这里是作品简介，字数超过适用「……」显示。

            div(class='detail-page__cta-row')
              a(class='btn btn-primary detail-page__read-btn' href='comic_chapter.html?id=1') 开始阅读

              div(class='detail-page__actions-bar')
                div(class='detail-page__action-cell flex-center')
                  +BtnComment
                div(class='detail-page__action-cell flex-center')
                  +BtnLike({ type: 3})
                div(class='detail-page__action-cell flex-center')
                  +BtnShare
                div(class='detail-page__action-cell flex-center')
                  +BtnReport(2)

      div(class='detail-page__tags')
        a(class='detail-page__tag' href="video_list.html?tag=1") #标签
        a(class='detail-page__tag' href="video_list.html?tag=2") #标签

      div(class='detail-page__tabs-wrap')
        div(class='detail-page__tab-bar')
          div(class='detail-page__tab-btns')
            button(type='button' class='novel-tab-btn detail-page__tab-btn is-active' data-tab='catalog')
              span 目录
              span(class='tab-catalog-count tab-count') (54)
              span(class='detail-page__tab-underline')
            button(type='button' class='novel-tab-btn detail-page__tab-btn' data-tab='comments')
              span 评论
              span(class='tab-comment-count tab-count') (54)
              span(class='detail-page__tab-underline')
          button(type='button' class='detail-page__sort-btn')
            svg(class='detail-page__sort-icon')
              use(href='/static/frontend/icons/icons.svg#sort')

        div
          div(class='novel-panel novel-panel-catalog detail-page__panel')
            div(class='')
              div(class='detail-page__catalog-list')
                a(class='detail-page__chapter-link' href='comic_chapter.html?id=1') 第1话 — 标题
                a(class='detail-page__chapter-link detail-page__chapter-link--current' href='comic_chapter.html?id=2') 第2话 — 标题
                a(class='detail-page__chapter-link' href='comic_chapter.html?id=3') 第3话 — 标题
              div(class='detail-page__expand-wrap')
                button(type='button' class='btn-expand-catalog detail-page__expand-btn')
                  span 全部展开
                  svg(class='detail-page__expand-icon')
                    use(href='/static/frontend/icons/icons.svg#arrow_down')

          div(class='novel-panel novel-panel-comments detail-page__panel detail-page__panel--hidden')
            div(class='')
              - var _detailCommentSample = '那個胖子癲側好一次能夾死三隻蚊子那個胖子癲側好一次能夾死三隻蚊子那個胖子癲側好一次能夾死三隻蚊子那個胖子癲側好一次能夾死三隻蚊子'
              div(class='detail-comment-list')
                each _i in [1, 2, 3]
                  article(class='detail-comment-item')
                    div(class='detail-comment-item__row')
                      img(class='detail-comment-item__avatar' src='/static/frontend/images/default.jpeg' alt='')
                      div(class='detail-comment-item__meta')
                        div(class='detail-comment-item__name') 用户昵称
                        div(class='detail-comment-item__time') 3小时前
                    div(class='detail-comment-item__text')= _detailCommentSample
              div(class='detail-page__expand-wrap')
                button(type='button' class='detail-page__expand-btn')
                  span 全部展开
                  svg(class='detail-page__expand-icon')
                    use(href='/static/frontend/icons/icons.svg#arrow_down')

      section(class='detail-page__hot' aria-label='热门推荐')
        header(class='detail-page__hot-head')
