              div(class="opacity-60") 每日签到领取10积分

            button(class="btn btn-primary btn-sign-item ml-auto") 立即前往

          div(class="bg-base7 flex items-center px-4 py-3 rounded overflow-hidden")
            <svg class="w-11 md:w-16 flex-shrink-0 object-fill" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
              <g fill="none" fill-rule="evenodd">
                <circle fill="#5996FF" cx="30" cy="30" r="30"/>
