                  <path d="M38.196 34.19H21.804c-.547 0-.911-.365-.911-.911 0-.547.364-.911.91-.911h16.393c.547 0 .911.364.911.91 0 .547-.364.911-.91.911zm0-9.654h-3.642c-.547 0-.911-.365-.911-.911s.364-.91.91-.91h3.643c.547 0 .911.364.911.91s-.364.91-.91.91zm0 4.918h-3.642c-.547 0-.911-.365-.911-.911 0-.547.364-.91.91-.91h3.643c.547 0 .911.363.911.91 0 .364-.364.91-.91.91zm0 9.653H21.804c-.547 0-.911-.364-.911-.91 0-.547.364-.911.91-.911h16.393c.547 0 .911.364.911.91 0 .547-.364.911-.91.911zM28.361 28.18c-.547.546-1.275.91-2.004.91-1.457 0-2.732-1.275-2.732-2.732 0-1.457 1.275-2.732 2.732-2.732.729 0 1.457.364 2.004.91h2.185a4.602 4.602 0 0 0-4.189-2.731c-2.55 0-4.553 2.003-4.553 4.553s2.003 4.554 4.553 4.554a4.602 4.602 0 0 0 4.19-2.732H28.36z"/>
                </g>
              </g>
            </svg>

            div(class="mx-4")
              div(class="text-xl font-medium") 点击广告
              div(class="opacity-60") 点击一次广告获得10积分

            button(class="btn btn-primary btn-sign-item ml-auto") 立即前往
          div(class="bg-base7 flex items-center px-4 py-3 rounded overflow-hidden")
            <svg class="w-11 md:w-16 flex-shrink-0 object-fill" viewBox="0 0 62 60" xmlns="http://www.w3.org/2000/svg">
              <g fill="none" fill-rule="evenodd">
                <ellipse fill="#30D667" cx="31" cy="30" rx="31" ry="30"/>
