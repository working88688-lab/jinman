extends includes/layout.pug


block css
  link(rel='stylesheet' href='/static/frontend/css/page.css')

block header
  +Header({
    active: ''
  })

block nav
  +Nav


block content
  section
    +BackHeader('积分签到')

    div(class="flex flex-col md:flex-row mt-3")
      div(class="flex-1")
        div(class='sign-header')
          div(class='user-box flex text-white items-center px-3 relative')
            div(class='rounded-full w-[60px] h-[60px] overflow-hidden')
              img(class='user_avatar' src="/static/frontend/images/default.jpeg" alt="")
            div(class='ml-4')
              div(class='mb-1 font-semibold user_name text-default md:text-2xl') 游客账号201213
              div(class='text-sm flex items-center gap-4')
                span 当前积分: 120
                span 邀请人数: 120
                span 注册人数: 120
        div(class="bg-base7 rounded overflow-hidden px-4 py-3 md:mt-5 hidden md:block sign-rule")
          h6(class="font-semibold text-xl mb-1") 温馨提示
          p 1、注册用户每日免费赠送3次
          p 2、用户分享链接被点击一次，获得5积分
          p 3、用户分享链接被注册，获得20积分
          p 4、每日签到赠送2积分
          p 5、点赞/评论赠送10积分
          p 6、点击广告获得10积分
          p 7、积分用于官方活动抽奖
      div(class="sign-border md:block")
      div(class="flex-1 mt-5 md:mt-0")
        div(class='grid grid-cols-1 gap-3')
          div(class="bg-base7 flex items-center px-4 py-3 rounded overflow-hidden")
