extends includes/layout.pug

block css
    link(rel="stylesheet", href="/static/frontend/css/page.css")
    link(rel="stylesheet", href="/static/frontend/css/lib/cropper.css")
block header
    +Header({
        active: 'home'
    })

block nav
    +Nav

block content
    section
      +BackHeader('基本资料')
      
    div(class='bg-white rounded py-5 px-3')
        input(type="file" id='avatarReader' class='hidden')
        div(class='max-w-[720px] m-auto')
            div(class='flex justify-between mb-3 pb-3 dx-hairline--bottom')
              span ID
              span(class='user_id')
            div(class='flex items-center justify-between my-3 pb-3 dx-hairline--bottom btn-open cursor-pointer' data-type='avatar')
              span 头像
              div(class='flex items-center')
                div(class='w-[48px] h-[48px] rounded-full overflow-hidden')
                  img(class='user_avatar' src="/static/frontend/images/default.jpeg")
                button(class='btn-link ml-2' type='button')
                    svg(class='w-3 h-3')
                        use(href='/static/frontend/icons/icons.svg#arrow_right')
 
            div(class='flex items-center justify-between my-3 pb-3 dx-hairline--bottom btn-open cursor-pointer' data-type='name')
              span 昵称
              div(class='flex items-center')
                span(class='user_name')
                button(class='btn-link ml-2' type='button')
                    svg(class='w-3 h-3')
                        use(href='/static/frontend/icons/icons.svg#arrow_right')

            div(class='flex items-center justify-between my-3 pb-3 dx-hairline--bottom btn-open cursor-pointer' data-type='gender')
              span 性别
              div(class='flex items-center')
                span(class='user_gender')
                button(class='btn-link ml-2' type='button')
                    svg(class='w-3 h-3')
                        use(href='/static/frontend/icons/icons.svg#arrow_right')
            div(class='flex items-center justify-between my-3 pb-3 dx-hairline--bottom btn-open cursor-pointer' data-type='password')
              span 登录密码
              div(class='flex items-center')
                span 修改
                button(class='btn-link ml-2' type='button')
                    svg(class='w-3 h-3')
                        use(href='/static/frontend/icons/icons.svg#arrow_right')
            div(class='flex items-center justify-between my-3 pb-3 dx-hairline--bottom')
              span 邮箱
              div(class='flex items-center')
                span(class='user_email')
            div(class='flex items-center justify-between my-3 pb-3 dx-hairline--bottom')
              span 注册日期
              div(class='flex items-center')
                span(class='user_reg_time')
            div(class='flex items-center justify-between my-3 pb-3 dx-hairline--bottom')
              span 金币
              div(class='flex items-center')
                span(class='user_coin')
            div(class='flex items-center justify-between mt-3')
              span 会员群组
              div(class='flex items-center')
                span(class='user_group')


block dialog

  //  回复评论
  div(id='common_modal' class='modal fade dx-modal')
    div(class='modal-dialog')
      div(class='modal-content')
        div(class='modal-header flex items-center')
          div(class='text-black font-bold')
            span(class='title')
          button(class='close text-subtitle ml-auto' type='button' data-dismiss='modal')
            svg(class='w-6 h-6')
                use(href='/static/frontend/icons/icons.svg#menu_close')
      div(class='modal-body')
        div(class='hidden name')
          div(class='input-control mb-3')
            input(class='form-control' autocomplete='off' type='text' placeholder='请输入昵称')
        div(class='hidden password')
          div(class='input-control has-icon-left has-icon-right mb-3')
            div(class="input-control-icon-left")
              svg(class='w-6 h-6')
                use(href='/static/frontend/icons/icons.svg#password')
            input(class='form-control !pl-7' id='original' autocomplete='off' type='password' placeholder='原始密码')
            div(class='input-control-icon-right btn-password-type')
              svg(class='w-5 h-5')
                use(class='close' href='/static/frontend/icons/icons.svg#close_eye_icon')
                use(class='open' href='/static/frontend/icons/icons.svg#view_icon')
          div(class='input-control has-icon-left has-icon-right mb-3')
            div(class="input-control-icon-left")
              svg(class='w-6 h-6')
                use(href='/static/frontend/icons/icons.svg#password')
            input(class='form-control !pl-7' id='new_password' autocomplete='off' type='password' placeholder='请设置新密码')
            div(class='input-control-icon-right btn-password-type')
              svg(class='w-5 h-5')
                use(class='close' href='/static/frontend/icons/icons.svg#close_eye_icon')
                use(class='open' href='/static/frontend/icons/icons.svg#view_icon')
          div(class='input-control has-icon-left has-icon-right mb-3')
            div(class="input-control-icon-left")
              svg(class='w-6 h-6')
                use(href='/static/frontend/icons/icons.svg#password')
            input(class='form-control !pl-7' id='confirm_password' autocomplete='off' type='password' placeholder='请确认新密码')
            div(class='input-control-icon-right btn-password-type')
              svg(class='w-5 h-5')
                use(class='close' href='/static/frontend/icons/icons.svg#close_eye_icon')
                use(class='open' href='/static/frontend/icons/icons.svg#view_icon')
        div(class='hidden gender')
          div(class='input-control mb-3')
            label(for="vip_recharge1" class='flex items-center mb-3 justify-between')
              | 男
              input(type="radio" class='!static' id='vip_recharge1' checked="checked" name='gender' value='1')
            label(for="gender1" class='flex items-center mb-3 justify-between')
              | 女
              input(type="radio" class='!static' id='gender1' checked="checked" name='gender' value='2')
        div(class='hidden avatar')
          div(class='mx-auto' style='max-width: 300px; padding: 12px; max-height: 300px')
            img(id="cropper_image" width="300" height="300" src="")

        button(class='btn-primary btn mt-4 btn-block btn-update' type='button') 保存
                

block hbs
    include includes/hbs/hbs-empty.pug

block footer-scripts
    script(data-main='/static/frontend/js/profiles_main.js' src="/static/frontend/js/lib/require.js")