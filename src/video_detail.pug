extends includes/layout.pug

block css
  link(rel='stylesheet' href='/static/frontend/css/lib/xgplayer.css')
  link(rel='stylesheet' href='/static/frontend/css/view_main.css?v=' + css_assets_version)
  link(rel='stylesheet' href='/static/frontend/css/new_searchbox.css')
  link(rel='stylesheet' href='/static/frontend/css/detail_pages.css')

block header
  +Header({
      active: 'video'
  })

block nav
  +Nav

block content

  div(class='video-detail-page text-font1')
    div(class='video-detail-page__main')
      +Breadcrumbs([{ title: '禁漫视频', isLink: true, href: 'video.html'}, { isLink: false},{ title: '全部视频', isLink: true, href: 'video_list.html'}, { isLink: false}, { title: '13331133131视频', isLink: true} ])

      h1(class='dx-title video-detail-page__title-pc')
        | 手机新浪网新闻中心，新浪网新闻中心是新浪网最重要的频道之每日编发新闻数以万计。

      div(class='video-detail-page__row')
        div(class='video-detail-page__player-col')
          div(class='aspect-w-16 aspect-h-9 video-detail-page__aspect-wrap')
            div(class='player-container')
              div(id='mse' class='video-detail-page__mse' data-url='https://hls.vdtuzv.com/videos2/39935e0bef81fba5b26ac4b203292c68/39935e0bef81fba5b26ac4b203292c68.m3u8?auth_key=1725527713-66d976a1375e5-0-586776a466ac9ccf2fcfa6804d248a9b&v=3&time=0&via=ap' data-poster='https://pic.shedtgs.cn/upload/upload/20231103/2023110315282821878.jpeg')
                img(class='mse-poster video-detail-page__poster' src='https://pic.shedtgs.cn/upload/upload/20231103/2023110315282821878.jpeg' alt='poster')

          h1(class='dx-title video-detail-page__title-m')
            | 手机新浪网新闻中心，新浪网新闻中心是新浪网最重要的频道之每日编发新闻数以万计。

          div(class='video-detail-page__rating-m')
            div(class='detail-page__stars-row--m')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_red')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_red')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_red')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_red')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_icon')
            div(class='detail-page__rating-m-text') 共 999,999 人参与评分

          div(class='video-detail-page__meta-m')
            div(class='video-detail-page__pill') 日本H漫
            div(class='video-detail-page__pill') 片商名称
            div(class='video-detail-page__meta-time')
              svg(width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg")
                path(d="M8.00098 1.8335C9.63636 1.83358 11.2049 2.48374 12.3613 3.64014C13.5176 4.79658 14.167 6.36514 14.167 8.00049C14.1669 9.63587 13.5177 11.2044 12.3613 12.3608C11.2049 13.5172 9.63636 14.1664 8.00098 14.1665C6.36563 14.1665 4.79707 13.5171 3.64062 12.3608C2.48423 11.2044 1.83407 9.63587 1.83398 8.00049C1.83398 6.36499 2.48415 4.79661 3.64062 3.64014C4.7971 2.48366 6.36547 1.8335 8.00098 1.8335ZM8.00098 8.00049H8L10 9.25049H10.001L8.23535 8.14697L8.00098 7.99951V8.00049Z" stroke="#666666")
              span 2025-12-16 更新

          div(class='video-detail-page__code-m')
            span(class='video-detail-page__code-label') 番号
            span(class='video-detail-page__code-sep') |
            span IPX - 971

          div(class='video-detail-page__synopsis-m')
            div(class='detail-page__synopsis-label-wrap')
              div(class='detail-page__synopsis-label') 作品简介
            div(class='detail-page__synopsis-rule')
            div(class='detail-page__synopsis-text') 这里是作品简介，字数超过适用「……」显示。这里是作品简介，字数超过适用「……」显示。这里是作品简介，字数超过适用「……」显示。这里是作品简介，字数超过适用「……」显示。

          div(class='video-detail-page__actions-m')
            div(class='video-detail-page__action-cell video-detail-page__action-cell--start')
              +BtnComment
            div(class='video-detail-page__action-cell flex-center')
              +BtnLike({ type: 2})
            div(class='video-detail-page__action-cell flex-center')
              +BtnShare
            div(class='video-detail-page__action-cell flex-center')
              +BtnReport(3)

        div(class='video-detail-page__side')
          div(class='video-detail-page__side-stack')
            div(class='video-detail-page__info-pill')
              span 动画
            div(class='video-detail-page__info-pill')
              span 片商名称
            div(class='video-detail-page__info-pill video-detail-page__info-pill--row')
              svg(width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg")
                path(d="M8.00098 1.8335C9.63636 1.83358 11.2049 2.48374 12.3613 3.64014C13.5176 4.79658 14.167 6.36514 14.167 8.00049C14.1669 9.63587 13.5177 11.2044 12.3613 12.3608C11.2049 13.5172 9.63636 14.1664 8.00098 14.1665C6.36563 14.1665 4.79707 13.5171 3.64062 12.3608C2.48423 11.2044 1.83407 9.63587 1.83398 8.00049C1.83398 6.36499 2.48415 4.79661 3.64062 3.64014C4.7971 2.48366 6.36547 1.8335 8.00098 1.8335ZM8.00098 8.00049H8L10 9.25049H10.001L8.23535 8.14697L8.00098 7.99951V8.00049Z" stroke="#666666")
              span 2025-11-25 上架
            div(class='video-detail-page__info-pill video-detail-page__info-pill--code')
              span(class='video-detail-page__code-label') 番号
              span(class='video-detail-page__code-sep') |
              span IPX - 971

          div(class='video-detail-page__intro-card')
            div(class='video-detail-page__intro-title') 作品简介
            div(class='video-detail-page__intro-rule')
            div(class='video-detail-page__intro-body')
              | 这里是作品简介这里是作品简介这里是作品简介这里是作品简介这里是作品简介这里是作品简介这里是作品简介这里是作品简介这里是作品简介这里是作品简介这里是作品简介这里是作品简介……

          div(class='video-detail-page__rating-card')
            div(class='detail-page__stars-row')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_red')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_red')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_red')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_red')
              svg(class='detail-page__star-icon')
                use(href='/static/frontend/icons/icons.svg#star_icon')
            div(class='video-detail-page__rating-card-meta') 共 999,999 人参与评分

          div(class='video-detail-page__ops')
            +BtnComment
            +BtnLike({ type: 2})
            +BtnShare
            +BtnReport(3)

      div(class='video-detail-page__tags')
        a(class='video-detail-page__tag' href="video_list.html?tag=1") #弟妹
        a(class='video-detail-page__tag' href="video_list.html?tag=2") #乱伦

      div(class='video-detail-page__tabs-wrap')
        div(class='detail-page__tab-bar')
          div(class='video-detail-page__comment-title')
            span 评论
            span (118)
            span(class='video-detail-page__comment-title-mark')
          button(type='button' class='detail-page__sort-btn')
            svg(class='detail-page__sort-icon')
              use(href='/static/frontend/icons/icons.svg#sort')

        div(class='video-detail-page__comment-body')
          div(class='detail-comment-list')
            - var _detailCommentSample = '那個胖子癲側好一次能夾死三隻蚊子那個胖子癲側好一次能夾死三隻蚊子那個胖子癲側好一次能夾死三隻蚊子那個胖子癲側好一次能夾死三隻蚊子'
            each _i in [1, 2, 3]
              article(class='detail-comment-item')
                div(class='detail-comment-item__row')
                  img(class='detail-comment-item__avatar' src='/static/frontend/images/default.jpeg' alt='')
                  div(class='detail-comment-item__meta')
                    div(class='detail-comment-item__name') 用户昵称
                    div(class='detail-comment-item__time') 3小时前
                div(class='detail-comment-item__text')= _detailCommentSample

          div(class='video-detail-page__expand-wrap')
            button(type='button' class='video-detail-page__expand-btn')
              span 全部展开
              svg(class='video-detail-page__expand-icon')
                use(href='/static/frontend/icons/icons.svg#arrow_down')

      section(class='video-detail-page__hot' aria-label='热门推荐')
        header(class='video-detail-page__hot-head')
          svg(class='video-detail-page__hot-head-icon' width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true')
