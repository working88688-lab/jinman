mixin Comic(item, index)
    a(href='comic_detail.html?id=1')
        div(class='flex aspect-w-11 group aspect-h-16 overflow-hidden')
            div( class='poster rounded-sm overflow-hidden pointer-events-auto')
                img(class="w-full h-full rounded-sm group-hover:scale-125 transition-all" src='/static/frontend/images/loading.svg' data-src=item.poster alt=item.title)
                div(class='w-full px-0.5 py-1 md:p-2 absolute left-0 top-0 flex flex-start' )
                    div(class='text-sm py-0.5 px-2  text-white rounded-large mr-2 bg-primary') 原创
                    div(class='text-sm py-0.5 px-2 dx-bg-linear text-white rounded-large') 连载中
                div(class='w-full px-0.5 py-1 md:p-2 absolute left-0 bottom-0 flex justify-between' )
                    if (index >= 0)
                        div(class='bg-primary w-5 h-4.5 mt-1 mr-1 flex-center text-white text-sm rounded-[6px] rounded-bl-none rounded-tr-none')= index
        div(class='block mt-0.5 text-sm')
            div(class='truncate text-default text-base2') 闺蜜让我出轨她男友（1v1）闺蜜让我出轨她男友（1v1）
            div(class='flex justify-between text-base3 my-0.5')
                span 韩国漫画
                span 剧情
            div(class='flex items-center text-base3')
                span(class='mr-auto') 5天前
                div(class='flex items-center mr-1')
                    svg(class='w-3 h-3 md:w-4 md:h-4 mr-0.5')
                        use(href='/static/frontend/icons/icons.svg#view')
                    span 128K
                div(class='flex items-center')
                    svg(class='w-3 h-3 md:w-4 md:h-4 mr-0.5')
                        use(href='/static/frontend/icons/icons.svg#like')
                    span 128K