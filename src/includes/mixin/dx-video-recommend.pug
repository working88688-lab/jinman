mixin VideoRecommend(item)
  div(class='video-item')
    .aspect-w-16.aspect-h-9.overflow-hidden
      a(href='view_video.html?id=1' class='poster bg-base2 overflow-hidden pointer-events-auto' data-url=item.url)
        img.w-full.h-full(src='/static/frontend/images/loading.svg' data-src=item.poster alt=item.title)
        .dx-bg-linear.w-full.px-2.py-2.absolute.left-0.bottom-0.flex.justify-end.gap-2
          span.text-sm 11:54
        div(class='video-preview w-full h-full left-0 top-0')
    div(class='text-font1 mt-1 px-2 md:px-0')
      a(href='view_video.html?id=1' class='line-clamp-2')= item.subtitle
      div(class='title flex text-sm mb-1.5')
        a(class='flex items-center mr-1' href='member?id=3')
          | #{item.title}
          svg(class='w-3 h-3.5 ml-1')
            use(href='/static/frontend/icons/icons.svg#badge')
        div(class='flex items-center')
          span(class='flex items-center mr-1')
            svg(class='w-5 h-4 mr-0.5')
              use(href='/static/frontend/icons/icons.svg#eye')
            | 2K
          span(class='flex items-center')
            svg(class='w-5 h-3.5 mr-0.5')
              use(href='/static/frontend/icons/icons.svg#like')
            | 88%