mixin VideoCover(item)
  div(class='video-item')
    div(class='aspect-w-16 aspect-h-12 overflow-hidden')
      a(href='./search.html?cid=1' class='poster bg-base2 overflow-hidden pointer-events-auto' data-url=item.url)
        img.w-full.h-full(src='/static/frontend/images/loading.svg' data-src=item.poster alt=item.title)
        div(class='dx-bg-linear w-full p-1.5 absolute left-0 bottom-0')
          strong(class='text-sm') 会所探花
          div(class='text-mini') 视频