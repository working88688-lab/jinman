mixin Banner(items)
    div(class='my-2 md:my-3 -mx-3 xl:mx-0')
        div(class='grid grid-cols-1 md:grid-cols-2 gap-2')
            each item in items
                div(class='dx-banner-item') 
                    a(class='dx-aspect-container' aria-label='广告' href='https://tea.dsvasouda.com/?code=bckQM&c=2663' rel="external nofollow" target="_blank")
                        img(src="/static/frontend/images/loading.svg", data-src='https://pic.eafgzz.cn/upload_01/upload/20240726/2024072612204893413.gif' alt="广告")
