mixin Header(config = {})
  // header
  header(id='app-header' class='text-xl w-full duration-300 transition-all')
    div(class='header fixed w-full left-0 top-0 bg-white')
      div(class='dx-container relative')
        //- button(class='whitespace-nowrap btn-search text-sm flex-shrink-0 w-[88px] h-[40px] bg-base3' type='button') 搜索
        div(class='app-header relative flex items-center w-full')
          button(class='md:hidden btn-menu-collapse mr-3' type='button' title='打开左侧菜单栏'  data-class='dx-drawer--open')
            svg(class='w-6 h-6')
              use(class='open' href='/static/frontend/icons/icons.svg#menu')
              use(class='close' href='/static/frontend/icons/icons.svg#menu_close')
          //  logo
          div(class='app-logo-container md:!flex mr-auto flex-shrink-0 flex-center')
            a(class='items-center flex justify-center md:justify-start' href='/')
              img(class='app-logo w-[60px] h-[23px] md:w-[120px] md:h-[45px]' src='/static/frontend/images/logo.png' title='logo' alt='logo')
          // mobile搜索
          if (config.showHeader)
            div(class='hidden flex-1 items-center md:!hidden mobile-search ')
              div(class='input-control flex-1 search-box search-box-circle flex items-center rounded-l-full overflow-visible bg-white')
                div(class='flex items-center pl-3  flex-shrink-0 whitespace-nowrap')
                  button(class='mr-1' data-type=config.type class='search_type text-3' type='button' title='切换搜索类型') 智能
                  span(class='text-border mx-1') |
                  span(class='search_category_wrapper relative inline-flex items-center overflow-visible')
                    button(class='flex items-center search_category_trigger text-3' type='button' title='选择分类' data-value='all')
                      span(class='search_category_label') 全部
                      svg(class='w-4 h-4 ml-1')
                        use(href='/static/frontend/icons/icons.svg#arrow_down')

                    // 分类下拉（移动端）
                    div(class='search_category_menu hide absolute left-1/2 -translate-x-1/2 top-full mt-2 w-[180px] bg-white rounded-sm shadow-lg border border-base1 overflow-hidden z-[999]')
                      button(type='button' class='w-full text-center px-4 py-4 search_category_item' data-value='all') 全部
                      button(type='button' class='w-full text-center px-4 py-4 search_category_item border-t border-base1' data-value='comic_list') 禁漫
                      button(type='button' class='w-full text-center px-4 py-4 search_category_item border-t border-base1' data-value='novel_list') 小说
                      button(type='button' class='w-full text-center px-4 py-4 search_category_item border-t border-base1' data-value='video_list') 视频

                input(class='form-control search-input flex-1   border-none rounded-l-full' data-type=config.search_type maxlength="100" autocomplete='off' type='search' placeholder='请输入您要搜索的内容')

                a(href="#" class="search-clear-btn flex-shrink-0 px-1")
                  svg(class='w-6 h-6 text-black')
                    use(href='/static/frontend/icons/icons.svg#menu_close')
              button(class='btn btn-primary w-[64px] flex-center btn-search flex-shrink-0 rounded-r-large' type='button' title='搜索')
                svg(class='w-6 h-6 text-white')
                  use(href='/static/frontend/icons/icons.svg#search')
              button(class='ml-3 text-default btn-close-search' type='button') 取消
          //  pc搜索框 
          if (config.showHeader)
            div(class='relative hide md:items-center md:flex justify-center  flex-[3] mr-4 md:mx-4')
              div(class='input-control search-box flex items-center flex-1  max-w-[480px] w-full border border-base1 rounded-l-large overflow-visible')
                div(class='flex items-center pl-4 pr-2 flex-shrink-0 whitespace-nowrap')
                  button(class='mr-1' data-type=config.type class='search_type' type='button' title='切换搜索类型') 智能
                  span(class='text-border mx-1') |
                  span(class='search_category_wrapper relative inline-flex items-center overflow-visible')
                    button(class='flex items-center search_category_trigger' type='button' title='选择分类' data-value='all')
                      span(class='search_category_label') 全部
                      svg(class='w-4 h-4 ml-1')
                        use(href='/static/frontend/icons/icons.svg#arrow_down')

                    // 分类下拉（PC）
                    div(class='search_category_menu hide absolute left-1/2 -translate-x-1/2 top-full mt-2 w-[180px] bg-white rounded-sm shadow-sm border border-base1 overflow-hidden z-[9999]')
                      button(type='button' class='w-full text-center px-4 py-4 search_category_item' data-value='all') 全部
                      button(type='button' class='w-full text-center px-4 py-4 search_category_item border-t border-base1' data-value='comic_list') 禁漫
                      button(type='button' class='w-full text-center px-4 py-4 search_category_item border-t border-base1' data-value='novel_list') 小说
                      button(type='button' class='w-full text-center px-4 py-4 search_category_item border-t border-base1' data-value='video_list') 视频

                input(data-type=config.search_type class='app-search w-[320px] max-w-[320px] flex-none px-4 search-input form-control border-none outline-none' maxlength="100" autocomplete='off' type='search' placeholder=config.placeholder)
                a(href="#" class="search-clear-btn flex-shrink-0 px-3")
                  svg(class='w-6 h-6 text-black')
                    use(href='/static/frontend/icons/icons.svg#menu_close')
              button(class='btn btn-primary btn-search w-[48px] flex-shrink-0 rounded-r-large' title='搜索')
                svg(class='w-5 h-5 text-white')
                  use(href='/static/frontend/icons/icons.svg#search')
          if (config.showHeader)
            // mobile 搜索icon
            div(class='flex-shrink-0 items-center md:hidden flex ml-auto justify-end')
              button(class='btn-open-search mr-3' type='button' title='search')
                svg(class='w-7 h-7 text-base3')
                  use(href='/static/frontend/icons/icons.svg#search')

          div(class='items-center md:hidden flex mobile-like')
            a(class='mr-3' href='favorite.html')
              svg(class='w-6 h-6 text-base3')
                use(href='/static/frontend/icons/icons.svg#heart')
            button(type='button' data-dismiss='popover' data-type='login' title='登录' class='btn-login')
              svg(class='w-6 h-6 text-base3')
                use(href='/static/frontend/icons/icons.svg#user_icon')
          div(class='popover-container relative hidden md:flex ml-auto items-center text-default text-black')
            button(class="mr-6" type='button' title='更多应用')
              svg(class='w-6 h-6 text-base3')
                use(href='/static/frontend/icons/icons.svg#more_app')
            div(class='login-container')
              button(class='btn-login py-2' data-dismiss='popover' data-type='register' type='button' title='登录') 注册
              span(class='mx-3') |
              button(class='btn-login py-2' data-dismiss='popover' data-type='login' type='button' title='登录') 登录
            div(class='logged-container hide')
              div(class='flex items-center')
                a(class='mr-3' href='favorite.html')
                  svg(class='w-6 h-6 text-base3')
                    use(href='/static/frontend/icons/icons.svg#heart')
                a(href='member.html')
                  svg(class='w-6 h-6 text-base3')
                    use(href='/static/frontend/icons/icons.svg#user_icon')

        
        nav(id='app-nav' class='dx-hairline--bottom hide md:block')
          ul(class='flex justify-between dx-container')
            each item in navs
              li(class='flex items-center' + (item.key === config.active ? ' is-active' : ''))
                if item.items
                  span(class='app-nav-item flex-1 py-1 text-center')=item.title
                else
                  a(class='app-nav-item flex-1 py-1 text-center' href=item.href)=item.title
                if item.items
                  svg(class='w-5 h-5 ml-0.5')
                    use(href='/static/frontend/icons/icons.svg#arrow_down')
                  
                  div(class='submenu text-base2')
                    each subItem in item.items
                      div(class='submenu-item')
                        a(href=subItem.href)= subItem.title

