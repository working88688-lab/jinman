mixin Pwa
    div(class='hidden z-50 dx-pwa-dialog h-[80px] relative')
        div(class='fixed bottom-0 left-0 right-0 bg-[#272727] dx-pwa')
            div(class='pl-3 pr-6 py-5 flex items-center relative text-default whitespace-nowrap')
                img(class='w-[44px] h-[44px] mr-4' src="/static/web/images/pwa_icon.png", alt="logo" title="logo")
                span 添加【
                strong 91porna
                span 】到主屏幕

                button(type='button' class='dx-open-pwa btn ml-auto min-w-[60px] !h-8 btn-primary rounded-large mr-3') 添加
                button(class='dx-pwa-close text-subtitle absolute right-1 top-1' type='button' data-dismiss='modal')
                    svg(class='w-6 h-6')
                        use(href='/static/frontend/icons/icons.svg#close')
    div(id='pwa_modal' class='modal fade dx-modal')
        div(class='modal-dialog !shadow-none !border-0' style="background-color: unset")
            div(class='modal-content')
                div(class='modal-body bg-base1 text-center')
                    div(class='swiper')
                        div(class='swiper-wrapper ios-swiper')
                            div(class='swiper-slide')
                                img(class='h-[256px] w-auto mt-3 mx-auto' data-static="1" data-src="/static/web/images/ios-1.png", alt="")
                                p(class='mt-3')  点击菜单点出底部弹框
                            div(class='swiper-slide')
                                img(class='h-[256px] w-auto mt-3 mx-auto' data-static="1"  data-src="/static/web/images/ios-2.png", alt="")
                                p(class='mt-3')  点击添加到主屏幕
                            div(class='swiper-slide')
                                img(class='h-[256px] w-auto mt-3 m-auto' data-static="1"  data-src="/static/web/images/ios-3.png", alt="")
                                p(class='mt-3')  点击添加
                            div(class='swiper-slide')
                                img(class='h-[256px] w-auto mt-3 mx-auto' data-static="1" data-src="/static/web/images/ios-4.png", alt="")
                                p(class='mt-3') 主屏幕一键打开【91porna.com】
                        div(class='swiper-wrapper and-swiper')
                            div(class='swiper-slide')
                                img(class='h-[256px] w-auto mt-3 mx-auto' data-static="1" data-src="/static/web/images/and-1.png", alt="")
                                p(class='mt-3') 点击更多出现侧边栏 
                                span(class='text-sm text-subtitle') 以上为Chrome浏览器 其他浏览器会有差异
                            div(class='swiper-slide')
                                img(class='h-[256px] w-auto mt-3 mx-auto' data-static="1"  data-src="/static/web/images/and-2.png", alt="")
                                p(class='mt-3') 点击添加到主屏幕
                                span(class='text-sm text-subtitle') 以上为Chrome浏览器 其他浏览器会有差异
                            div(class='swiper-slide')
                                img(class='h-[256px] w-auto mt-3 m-auto' data-static="1"  data-src="/static/web/images/and-3.png", alt="")
                                p(class='mt-3') 点击添加
                                span(class='text-sm text-subtitle') 以上为Chrome浏览器 其他浏览器会有差异
                            div(class='swiper-slide')
                                img(class='h-[256px] w-auto mt-3 mx-auto' data-static="1" data-src="/static/web/images/and-4.png", alt="")
                                p(class='mt-3') 主屏幕一键打开【91porna.com】
                                span(class='text-sm text-subtitle') 以上为Chrome浏览器 其他浏览器会有差异
                        div(class='swiper-pagination !static')
                    
                div(class='flex-center mt-3')
                    div(class='bg-base1 rounded-full p-3')
                        button(class='close text-subtitle' type='button' data-dismiss='modal')
                            svg(class='w-6 h-6')
                                use(href='/static/frontend/icons/icons.svg#close')
