mixin Tab 
     div(class='dx-tag-tab hide md:block')
        h1(class='text-2xl flex items-center pt-2 pb-4')
          | 热门色情片
          svg(class='w-4 h-4 ml-1.5')
            use(href='/static/frontend/icons/icons.svg#international')
        div(class='hot-tags relative px-[48px] mb-5')
            div(class='left-arrow pr-5 arrow-container px-3 py-3.5 left-0 top-0 absolute' data-direction='1')
                svg(class='w-4 h-4')
                    use(href='/static/frontend/icons/icons.svg#left-arrow')
            div(class='overflow-hidden')
                div(class='flex scroll-container')
                    - var items = ['乱伦', '萝莉', '熟女', '自慰', '黑人', '巨乳', '母子', '学生', '绿帽', '偷情', '按摩', '少妇', '内射', '调教', '换妻', 'COS', '探花', '情侣', '巨根黑人', '网袜', '网曝门', '韩国', '娱乐圈', '吃瓜黑料', '海角', '儿媳', '会所spa', '街头搭讪', '粉穴美乳', '香港三级']
                    ul(class='flex text-nowrap text-xl')
                        each item in items
                            li(class='flex flex-shrink-0 items-center mr-1 last:mr-0')
                                a(class='flex-1 py-2.5 px-4 rounded-large bg-base2' href="search.html?keyword=学生")= item
            div(class='right-arrow pl-5 arrow-container px-3 py-3.5 right-0 top-0 absolute' data-direction='-1')
                svg(class='w-4 h-4 ')
                    use(href='/static/frontend/icons/icons.svg#right-arrow')