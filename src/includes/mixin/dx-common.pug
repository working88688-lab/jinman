        svg(class='w-3.5 h-3.5 cursor-pointer mr-1')
            use(href='/static/frontend/icons/icons.svg#star_red')
        svg(class='w-3.5 h-3.5 cursor-pointer mr-1')
            use(href='/static/frontend/icons/icons.svg#star_red')
        svg(class='w-3.5 h-3.5 cursor-pointer mr-1')
            use(href='/static/frontend/icons/icons.svg#star_red')
        svg(class='w-3.5 h-3.5 cursor-pointer mr-1')
            use(href='/static/frontend/icons/icons.svg#star_red')
        svg(class='w-3.5 h-3.5 cursor-pointer')
