mixin VideoRowCard(item)
  a(class='video-item flex' href='view_video.html?id=1')
    div(class='w-1/2 flex-shrink-0 mr-1')
        div(class='aspect-w-16 aspect-h-9 overflow-hidden')
            div( class='poster bg-base2 overflow-hidden pointer-events-auto' data-url=item.url)
                img.w-full.h-full(src='/static/frontend/images/loading.svg' data-src=item.poster alt=item.title)
                .dx-bg-linear.w-full.px-2.py-2.absolute.left-0.bottom-0.flex.justify-between.gap-2
                    span.text-sm 1.3w播放
                    span.text-sm 11:54
                div(class='video-preview w-full h-full absolute left-0 top-0')
    div(class='text-font1 px-3 md:px-0')
      div(class='line-clamp-2 mb-1.5')= item.subtitle

      div(class='title text-sm')
        div(class='flex items-center mb-1.5')
          | #{item.title}
          svg(class='w-3 h-3.5 ml-1')
            use(href='/static/frontend/icons/icons.svg#badge')
        div(class='flex items-center')
          span(class='flex items-center mr-1')
            svg(class='w-5 h-4 mr-0.5')
              use(href='/static/frontend/icons/icons.svg#eye')
            | 2K
          span(class='flex items-center')
            svg(class='w-5 h-3.5 mr-0.5')
              use(href='/static/frontend/icons/icons.svg#like')
            | 88%