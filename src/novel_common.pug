
extends includes/layout.pug


include includes/mixin/dx-novel-card.pug
include includes/mixin/dx-filter.pug

block css
    link(rel="stylesheet" href="/static/frontend/css/home-page-banner.css?v=" + css_assets_version)

block header
    +Header({
        active: 'novel',
        showHeader: false,
        placeholder: '搜索小说作品',
        search_type: 'novel'
    })

block nav
    +Nav

block content
    +Breadcrumbs([{  title: '禁漫小说', isLink: true, href: "novel.html" }, { isLink: false }, {  title: '小说排行榜',isLink: true }])
    h1(class="dx-comic-list-heading my-2 md:my-3") 小说排行榜

    div(class='index-content')
        section(class="my-2 md:my-3")
           
        
            ul(class='grid grid-cols-1 md:grid-cols-2 gap-2.5 md:gap-4')
                each val in [...videos, ...videos]
                    li
                        +NovelCard(val)
     
        
            +SimplePager({ page: 'novel_common.html'})
     

      
block footer-scripts
    script(data-main='/static/frontend/js/list_main.js' src="/static/frontend/js/lib/require.js")