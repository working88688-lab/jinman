                    </svg>

                | 积分签到

        button(class='btn btn-primary btn-block btn-logout mt-3' type='button') 退出登录




block footer-scripts
    script(data-main='/static/frontend/js/member_main.js' src="/static/frontend/js/lib/require.js")
