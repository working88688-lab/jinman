extends includes/layout.pug


block css
    link(rel="stylesheet" href="/static/frontend/css/page.css")
block header
    +Header({
        active: 'home'
    })

block nav
    +Nav


block content

    div(class='max-w-[720px] m-auto')
        div(class='dx-fix-margin')
            div(class='user-box flex text-white items-center p-3 relative')
                div(class='rounded-full w-[60px] h-[60px] overflow-hidden')
                    img(class='user_avatar' src="/static/frontend/images/default.jpeg" alt="")
                div(class='ml-4')
                    div(class='mb-1 font-semibold user_name') 
                    div(class='text-sm user_id') 


        div(class='grid grid-cols-2 gap-3 mt-3')
            a(class='bg-white flex items-center rounded justify-between px-4 py-8' href='vip.html')
                div(class='flex items-center')
                    svg(class='w-5 h-5 mr-2')
                        use(href='/static/frontend/icons/icons.svg#buy_vip')
                    span(class='font-bold') 购买VIP

                svg(class='w-3 h-3')
                    use(href='/static/frontend/icons/icons.svg#arrow_right')
            a(class='bg-white flex items-center rounded justify-between px-4 py-8' href='coin.html')
                div(class='flex items-center')
                    svg(class='w-5 h-5 mr-2')
                        use(href='/static/frontend/icons/icons.svg#buy_coin')
                    span(class='font-bold') 充值U币

                svg(class='w-3 h-3')
                    use(href='/static/frontend/icons/icons.svg#arrow_right')

        div(class='mt-3 bg-white grid grid-cols-4 gap-4 rounded text-base2 p-5')
            a(class='flex-col-center' href='profiles.html')
                div(class='w-[48px] h-[48px] mb-1 rounded-full flex-col-center bg-base7 p-1.5')
                    svg(class='w-5 h-5')
                        use(href='/static/frontend/icons/icons.svg#setting2')
                | 基本资料
            a(class='flex-col-center' href='favorite.html')
                div(class='w-[48px] h-[48px] mb-1 rounded-full flex-col-center bg-base7 p-1.5')
                    svg(class='w-5 h-5')
                        use(href='/static/frontend/icons/icons.svg#collect_star')
                | 我的收藏
            a(class='flex-col-center' href='invite.html')
                div(class='w-[48px] h-[48px] mb-1 rounded-full flex-col-center bg-base7 p-1.5')
                    svg(class='w-5 h-5')
                        use(href='/static/frontend/icons/icons.svg#invite')
                | 邀请好友
            a(class='flex-col-center' href='backup.html')
                div(class='w-[48px] h-[48px] mb-1 rounded-full flex-col-center bg-base7 p-1.5')
                    svg(class='w-5 h-5')
                        use(href='/static/frontend/icons/icons.svg#way_home')
                | 回家的路
            a(class='flex-col-center' href='contact.html')
                div(class='w-[48px] h-[48px] mb-1 rounded-full flex-col-center bg-base7 p-1.5')
                    svg(class='w-5 h-5')
                        use(href='/static/frontend/icons/icons.svg#contact_us_2')
                | 联系我们
            a(class='flex-col-center' href='sign.html')
                div(class='w-[48px] h-[48px] mb-1 rounded-full flex-col-center bg-base7 p-1.5')
                    <svg  viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
                        <g fill="none" fill-rule="evenodd">
                            <circle fill="#F6F6F6" cx="42" cy="42" r="42"/>
                            <path d="M25 25h34v34H25z"/>
