extends includes/layout.pug

include includes/mixin/dx-filter.pug


block css
    link(rel="stylesheet" href="/static/frontend/css/home-page-banner.css?v=" + css_assets_version)

block header
    +Header({
        active: 'video',
        showHeader: true,
        placeholder: '搜索视频作品',
        search_type: 'video_list'
    })

block nav
    +Nav


block content
    +ListPageHeader(
        [{ title: '禁漫视频', isLink: true, href: 'video.html' }, { isLink: false }, { title: '全部视频', isLink: true }],
        '全部视频'
    )
    +Filter

    div(class='index-content')
        
        ul(class='dx-video-list mt-3 gap-2.5 md:gap-4')
            each val in [...videos, ...videos]
                li
                    +VideoItem(val)

        +SimplePager({ page: 'video_list.html'})
      
     

      
block footer-scripts
    script(data-main='/static/frontend/js/list_main.js' src="/static/frontend/js/lib/require.js")