
extends includes/layout.pug


include includes/mixin/dx-novel-card.pug


block css
    link(rel="stylesheet" href="/static/frontend/css/home-page-banner.css?v=" + css_assets_version)

block header
    +Header({
        active: 'comic',
        showHeader: false,
        placeholder: '搜索小说作品',
        search_type: 'comic'
    })

block nav
    +Nav


block content
    +Breadcrumbs([{  title: '禁漫漫画', isLink: true, href: "comic.html" }, { isLink: false }, {  title: '禁漫排行榜',isLink: true }])
    h1(class="dx-comic-list-heading my-2 md:my-3") 禁漫排行榜

    div(class='index-content')
         
        ul(class='dx-novel-list mt-3 gap-2.5 md:gap-4')
            each val, index in [...videos, ...videos, ...videos, ...videos.slice(0,2)]
                li
                    +Comic(val)

        +SimplePager({ page: 'comic_common.html'})
     

      
block footer-scripts
    script(data-main='/static/frontend/js/list_main.js' src="/static/frontend/js/lib/require.js")